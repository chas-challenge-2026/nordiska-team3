# Backend API base URL, read by the frontend as VITE_API_URL.
# Local development uses the value below (the API listens on port 5077).
# To override it on your machine, put your own value in .env.local (git-ignored).
# In production the value is empty, because the API serves the frontend itself and calls go to the same address.
VITE_API_URL=http://localhost:5077