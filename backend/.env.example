# Settings the API reads from the environment. Copy this file to .env (it is git-ignored) and fill in the values.
# .NET does NOT read .env files by itself: this file is a list of the settings, their names and what they do.
# How to set them for a local run: see docs/local-development.md (dotnet user-secrets).
# In an environment variable, ":" in a setting name is written "__", so Jwt:Key becomes Jwt__Key.

# --- Secrets: never commit real values ---

# Connection string to Postgres, including the password.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=nordiska;Username=nordiska;Password=change-me

# Key that signs login tokens (JWT). At least 32 characters, random.
# In Docker it is optional: if missing, the API creates one in /secrets/jwt.key and reuses it after restarts.
Jwt__Key=change-me-to-a-long-random-value

# Key that encrypts personal numbers: base64, at least 32 random bytes.
# In Docker it is optional: if missing, the API creates one in /secrets/pn.key on the very first start.
# Never change it once the database holds encrypted personal numbers, or the API refuses to start.
PersonalNumberProtection__Key=change-me-base64

# --- Settings that differ between environments ---

Jwt__Issuer=NordiskaPortal.API
Jwt__Audience=NordiskaPortal.Client

# Addresses the frontend is served from (CORS). One line per address, numbered from 0.
Cors__AllowedOrigins__0=http://localhost:5173

# --- Other settings (defaults are in appsettings.json) ---
# RateLimiting__AuthPerMinute, RateLimiting__RefreshPerMinute, RateLimiting__MoneyTransactionPerMinute,
# RateLimiting__TaxReportPerMinute, RateLimiting__AccountLookupPerMinute
# Bank__Name, Bank__OrganizationNumber, Bank__Address, Bank__Phone, Bank__Email
# TaxReport__PdfGeneratorPath, TaxReport__PdfSignerPath, TaxReport__PrivateKeyPath, TaxReport__OutputDirectory
# ForwardedHeaders__KnownProxies__0, ForwardedHeaders__KnownNetworks__0